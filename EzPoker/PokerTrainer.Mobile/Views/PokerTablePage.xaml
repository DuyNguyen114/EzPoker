<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PokerTrainer.Mobile.Views.PokerTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Poker Table"
    BackgroundColor="#101512">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto"
          Padding="16"
          RowSpacing="12">

        <!-- HEADER -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="24"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#222B25"
                    TextColor="White" />

            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 Spacing="2">

                <Label x:Name="HandTitleLabel"
                       Text="Hand #1"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="BlindLabel" Text="No Limit Hold'em"
                       FontSize="12"
                       TextColor="#A0AAA4"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="↶"
                    FontSize="20"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#222B25"
                    TextColor="White" />

        </Grid>

        <!-- STREET -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="6">

            <Border x:Name="PreFlopBorder"
                    Grid.Column="0"
                    Padding="8"
                    BackgroundColor="#2FA96D"
                    StrokeThickness="0">

                <Label x:Name="PreFlopLabel"
                       Text="Preflop"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

            </Border>

            <Border x:Name="FlopBorder"
                    Grid.Column="1"
                    Padding="8"
                    BackgroundColor="#222B25"
                    StrokeThickness="0">

                <Label x:Name="FlopLabel"
                       Text="Flop"
                       TextColor="#A0AAA4"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

            </Border>

            <Border x:Name="TurnBorder"
                    Grid.Column="2"
                    Padding="8"
                    BackgroundColor="#222B25"
                    StrokeThickness="0">

                <Label x:Name="TurnLabel"
                       Text="Turn"
                       TextColor="#A0AAA4"
                       HorizontalTextAlignment="Center" />

            </Border>

            <Border x:Name="RiverBorder"
                    Grid.Column="3"
                    Padding="8"
                    BackgroundColor="#222B25"
                    StrokeThickness="0">

                <Label x:Name="RiverLabel"
                       Text="River"
                       TextColor="#A0AAA4"
                       HorizontalTextAlignment="Center" />

            </Border>

        </Grid>

        <!-- POKER TABLE -->
        <AbsoluteLayout x:Name="PokerTableLayout"
                        Grid.Row="2"
                        MinimumHeightRequest="380">

            <!-- Mặt bàn -->
            <Border ZIndex="0"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.88,0.72"
                    AbsoluteLayout.LayoutFlags="All"
                    BackgroundColor="#174C34"
                    Stroke="#76502D"
                    StrokeThickness="7">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="150" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="12">

                    <Label Text="TỔNG POT"
                           FontSize="12"
                           TextColor="#B9C8BF"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="PotLabel"
                           Text="180"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="StreetPotLabel"
                           Text="Street: 0"
                           FontSize="12"
                           TextColor="#B9C8BF"
                           HorizontalTextAlignment="Center"
                        />

                    <!-- Community cards -->
                    <HorizontalStackLayout Spacing="6">

                        <Border WidthRequest="42"
                                HeightRequest="56"
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Label Text="K♥"
                                   TextColor="#C83E3E"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                        <Border WidthRequest="42"
                                HeightRequest="56"
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Label Text="8♠"
                                   TextColor="#172019"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                        <Border WidthRequest="42"
                                HeightRequest="56"
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Label Text="3♦"
                                   TextColor="#C83E3E"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            

        </AbsoluteLayout>

        <!-- BET AMOUNT -->
        <Grid Grid.Row="3"
              ColumnDefinitions="48,*,48"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Text="−"
                    FontSize="22"
                    BackgroundColor="#222B25"
                    TextColor="White"
                    Clicked="DecreaseBet_Clicked" />

            <Entry x:Name="BetAmountEntry"
                   Grid.Column="1"
                   Text="120"
                   Keyboard="Numeric"
                   HorizontalTextAlignment="Center"
                   TextColor="White"
                   BackgroundColor="#19201C"
                   Placeholder="Số chip" />

            <Button Grid.Column="2"
                    Text="+"
                    FontSize="22"
                    BackgroundColor="#222B25"
                    TextColor="White"
                    Clicked="IncreaseBet_Clicked" />

        </Grid>

        <!-- ACTION BUTTONS -->
        <Grid x:Name="ActionButtonsGrid"
              Grid.Row="4"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="8">

            <Button x:Name="FoldButton"
                    Grid.Column="0"
                    Text="FOLD"
                    HeightRequest="54"
                    BackgroundColor="#472522"
                    TextColor="#E46B65"
                    FontAttributes="Bold"
                    Clicked="Fold_Clicked" />

            <Button x:Name="CallButton"
                    Grid.Column="1"
                    Text="CALL"
                    HeightRequest="54"
                    BackgroundColor="#222B25"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Call_Clicked" />

            <Button Grid.Column="2"
                    x:Name="RaiseButton"
                    Text="RAISE"
                    HeightRequest="54"
                    BackgroundColor="#2FA96D"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Raise_Clicked" />
            
            <Button x:Name="AllInButton"
            Grid.Column="3"
            Text="ALL-IN"
            HeightRequest="54"
            BackgroundColor="#8B3F91"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="12"
            Clicked="AllIn_Clicked" />

        </Grid>

        <Button x:Name="NextStreetButton"
        Grid.Row="5"
        Text="CHUYỂN SANG FLOP"
        HeightRequest="48"
        BackgroundColor="#D99B18"
        TextColor="White"
        FontAttributes="Bold"
        IsVisible="False"
        Clicked="NextStreet_Clicked" />

        <VerticalStackLayout Grid.Row="6" Spacing="8">
            <VerticalStackLayout x:Name="ShowdownPanel"
                                 IsVisible="False"
                                 Spacing="8">
                <Label Text="Showdown - Chọn người thắng"
                       TextColor="White"
                       FontAttributes="Bold" />
                
                <ScrollView HeightRequest="180">
                    <VerticalStackLayout x:Name="PotChoicesLayout" Spacing="4" />
                </ScrollView>

                <Button x:Name="AwardPotButton"
                        Text="TRAO POT"
                        BackgroundColor="#2FA96D"
                        IsEnabled="False"
                        Clicked="AwardPot_Clicked" />
            </VerticalStackLayout>
            
            <Label x:Name="HandResultLabel"
                   TextColor="#F0BD4F"
                   IsVisible="False" />

            <Button x:Name="NewHandButton"
            Text="HAND MỚI"
            IsVisible="False"
            Clicked="NewHand_Clicked" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
