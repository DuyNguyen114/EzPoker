<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PokerTrainer.Mobile.Views.PokerTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Poker Table"
    BackgroundColor="#101512">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
          Padding="16"
          RowSpacing="12">

        <!-- HEADER -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="24"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#222B25"
                    TextColor="White" />

            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 Spacing="2">

                <Label Text="Hand #1"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

                <Label Text="No Limit Hold'em • 10 / 20"
                       FontSize="12"
                       TextColor="#A0AAA4"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="↶"
                    FontSize="20"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#222B25"
                    TextColor="White" />

        </Grid>

        <!-- STREET -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="6">

            <Border Grid.Column="0"
                    Padding="8"
                    BackgroundColor="#222B25"
                    StrokeThickness="0">

                <Label Text="Preflop"
                       TextColor="#46C486"
                       HorizontalTextAlignment="Center" />

            </Border>

            <Border Grid.Column="1"
                    Padding="8"
                    BackgroundColor="#2FA96D"
                    StrokeThickness="0">

                <Label Text="Flop"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

            </Border>

            <Border Grid.Column="2"
                    Padding="8"
                    BackgroundColor="#222B25"
                    StrokeThickness="0">

                <Label Text="Turn"
                       TextColor="#A0AAA4"
                       HorizontalTextAlignment="Center" />

            </Border>

            <Border Grid.Column="3"
                    Padding="8"
                    BackgroundColor="#222B25"
                    StrokeThickness="0">

                <Label Text="River"
                       TextColor="#A0AAA4"
                       HorizontalTextAlignment="Center" />

            </Border>

        </Grid>

        <!-- POKER TABLE -->
        <AbsoluteLayout x:Name="PokerTableLayout"
                        Grid.Row="2"
                        MinimumHeightRequest="380">

            <!-- Mặt bàn -->
            <Border ZIndex="0"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.88,0.72"
                    AbsoluteLayout.LayoutFlags="All"
                    BackgroundColor="#174C34"
                    Stroke="#76502D"
                    StrokeThickness="7">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="150" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="12">

                    <Label Text="TỔNG POT"
                           FontSize="12"
                           TextColor="#B9C8BF"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="PotLabel"
                           Text="180"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <!-- Community cards -->
                    <HorizontalStackLayout Spacing="6">

                        <Border WidthRequest="42"
                                HeightRequest="56"
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Label Text="K♥"
                                   TextColor="#C83E3E"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                        <Border WidthRequest="42"
                                HeightRequest="56"
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Label Text="8♠"
                                   TextColor="#172019"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                        <Border WidthRequest="42"
                                HeightRequest="56"
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Label Text="3♦"
                                   TextColor="#C83E3E"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            

        </AbsoluteLayout>

        <!-- BET AMOUNT -->
        <Grid Grid.Row="3"
              ColumnDefinitions="48,*,48"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Text="−"
                    FontSize="22"
                    BackgroundColor="#222B25"
                    TextColor="White"
                    Clicked="DecreaseBet_Clicked" />

            <Entry x:Name="BetAmountEntry"
                   Grid.Column="1"
                   Text="120"
                   Keyboard="Numeric"
                   HorizontalTextAlignment="Center"
                   TextColor="White"
                   BackgroundColor="#19201C"
                   Placeholder="Số chip" />

            <Button Grid.Column="2"
                    Text="+"
                    FontSize="22"
                    BackgroundColor="#222B25"
                    TextColor="White"
                    Clicked="IncreaseBet_Clicked" />

        </Grid>

        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="4"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Text="FOLD"
                    HeightRequest="54"
                    BackgroundColor="#472522"
                    TextColor="#E46B65"
                    FontAttributes="Bold"
                    Clicked="Fold_Clicked" />

            <Button Grid.Column="1"
                    Text="CALL 40"
                    HeightRequest="54"
                    BackgroundColor="#222B25"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Call_Clicked" />

            <Button Grid.Column="2"
                    x:Name="RaiseButton"
                    Text="RAISE 120"
                    HeightRequest="54"
                    BackgroundColor="#2FA96D"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Raise_Clicked" />

        </Grid>

    </Grid>

</ContentPage>